{
  "Runtime": { "ExecutionMode": "MultiProcess" },
  "NotificationRouting": { "Mode": "OwnerOnly" },
  "TargetGroupNames": [
    "請填入目標 LINE 群組名稱"
  ],
  "Reliability": {
    "RecoveryLookbackHours": 24
  },
  "NotificationDatabase": {
    "Enabled": true,
    "DatabasePath": "C:\\Users\\YOUR_USER\\AppData\\Local\\Microsoft\\Windows\\Notifications\\wpndatabase.db",
    "SqlitePath": "C:\\path\\to\\sqlite3.exe",
    "PollMilliseconds": 1000,
    "RetryCount": 4,
    "RetryDelayMilliseconds": 250
  },
  "Ai": {
    "Enabled": false,
    "Endpoint": "https://api.openai.com/v1/responses",
    "Model": "gpt-5-mini",
    "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
    "ContextMessageLimit": 12,
    "TimeoutSeconds": 20,
    "IncludeLocalImages": true,
    "MaxImagesPerNotification": 1,
    "MaxImageBytes": 4194304,
    "ImageDetail": "high"
  },
  "Pushover": {
    "Enabled": false,
    "AppTokenEnvironmentVariable": "PUSHOVER_APP_TOKEN",
    "UserKeyEnvironmentVariable": "PUSHOVER_USER_KEY",
    "RetrySeconds": 30,
    "ExpireSeconds": 1800,
    "Sound": "persistent"
  }
}
