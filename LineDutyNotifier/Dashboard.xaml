<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LINE 值班監測台" Width="1120" Height="850" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Microsoft JhengHei UI, Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#263548"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="18,9"/><Setter Property="Background" Value="#163E63"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
  </Window.Resources>
  <DockPanel Margin="28">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="LINE 值班監測台" FontSize="28" FontWeight="Bold"/><TextBlock Text="本機唯讀儀表板  /  不顯示聊天內容與金鑰" Foreground="#64748B" Margin="0,7,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Name="ManageTeamButton" Content="接刀排程與人員" Margin="0,0,8,0"/>
          <Button Name="OpenBillingButton" Content="官方餘額" Margin="0,0,8,0" ToolTip="開啟 OpenAI API 組織帳務頁面"/>
          <Button Name="RefreshButton" Content="立即更新"/>
        </StackPanel>
        <TextBlock Name="UpdatedText" Text="準備讀取狀態…" FontSize="12" Foreground="#64748B" Margin="0,8,0,0" HorizontalAlignment="Right"/>
      </StackPanel>
    </Grid>
    <TextBlock DockPanel.Dock="Bottom" Text="關閉這個視窗不會停止監測器。每 5 秒重新讀取；監測器心跳約每 30 秒更新。" FontSize="12" Foreground="#64748B" Margin="0,14,0,0"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,0">
        <Border Name="OverviewBorder" CornerRadius="12" Background="#E7EDF4" Padding="22,18" Margin="0,0,0,18">
          <StackPanel><TextBlock Name="OverviewTitle" Text="正在讀取監測狀態" FontSize="23" FontWeight="Bold"/><TextBlock Name="OverviewDetail" Text="會核對程序身分、心跳新鮮度與最後成功讀取時間。" Margin="0,7,0,0"/></StackPanel>
        </Border>
        <TextBlock Text="執行模式與記憶體" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <UniformGrid Name="RuntimeGrid" Columns="3" Margin="-5,0,-5,8"/>
        <TextBlock Name="RuntimeText" Text="實際程序記憶體：讀取中" TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>
        <TextBlock Text="監測工作狀態（工作項目不等於程序數）" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <UniformGrid Name="WorkersGrid" Columns="4" Margin="-5,0,-5,18"/>
        <TextBlock Text="通知流程" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <UniformGrid Name="MetricsGrid" Columns="4" Margin="-5,0,-5,10"/>
        <TextBlock Name="QueueDetail" Text="正在讀取佇列…" FontSize="12" Foreground="#64748B" Margin="0,0,0,18"/>
        <TextBlock Text="AI Token 使用量" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <UniformGrid Name="UsageGrid" Columns="3" Margin="-5,0,-5,10"/>
        <TextBlock Name="UsageDetail" Text="正在讀取本機用量紀錄…" FontSize="12" Foreground="#64748B" Margin="0,0,0,18"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="最近運作紀錄" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="最近兩個日誌，各讀取末 2,000 行；僅列安全事件摘要。" FontSize="11" Foreground="#64748B" Margin="0,6,0,12"/>
            <ItemsControl Name="EventsList"><ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayTime}" Foreground="#64748B" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"/>
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Name="NoEventsText" Text="尚無可顯示的事件" Foreground="#64748B"/>
          </StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="設定與提醒" FontSize="18" FontWeight="Bold"/>
            <TextBlock Name="AiSetting" Text="AI：檢查中" Margin="0,14,0,9"/>
            <TextBlock Name="PushSetting" Text="Pushover：檢查中" Margin="0,0,0,9"/>
            <TextBlock Name="GroupSetting" Text="群組篩選：檢查中" Margin="0,0,0,14"/>
            <Border Background="#F1F5F9" CornerRadius="8" Padding="12"><TextBlock Text="已設定金鑰不代表 API 可連線。Pushover 已接受也不代表 iPhone 已響鈴；請查看「等待手機確認」。" FontSize="12" Foreground="#475569"/></Border>
            <TextBlock Name="IssuesText" Text="" Foreground="#B45309" FontSize="12" Margin="0,12,0,0"/>
          </StackPanel></Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
